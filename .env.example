# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=villagemart
MYSQL_USER=villagemart
MYSQL_PASSWORD=change-me
DB_URL=jdbc:mysql://localhost:3306/villagemart?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=villagemart
DB_PASSWORD=change-me

# --- Security ---
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes-base64
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30

# --- Initial owner (used only when no user exists) ---
OWNER_USERNAME=owner
OWNER_MOBILE=9876543210
OWNER_NAME=VillageMart Owner
OWNER_PASSWORD=change-me-strong-password

# --- Business defaults (editable later in Settings) ---
BUSINESS_NAME=VillageMart
BUSINESS_ADDRESS=Main Road, Your Town
BUSINESS_MOBILE=9876543210

# --- API ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true

# --- Firebase Cloud Messaging (optional) ---
# Base64 of the Firebase service-account JSON. Leave empty to disable push (alerts remain on dashboard).
FIREBASE_CREDENTIALS_BASE64=
